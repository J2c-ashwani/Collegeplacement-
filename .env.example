# =============================================================================
# PlacementConnect — Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/placementconnect?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/placementconnect?schema=public"

# --- Application ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PlacementConnect"
NODE_ENV="development"

# --- Auth.js ---
AUTH_SECRET="generate-a-strong-secret-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# --- Razorpay ---
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# --- Storage (S3-compatible: AWS S3, Cloudflare R2, MinIO) ---
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="placementconnect-documents"
# Set to "local" for local file storage during development
STORAGE_PROVIDER="local"

# --- Email (Resend) ---
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="PlacementConnect <noreply@yourdomain.com>"
# Set to "console" to log emails to console during development
EMAIL_PROVIDER="console"

# --- WhatsApp Business API (Interface ready) ---
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- Monitoring ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Analytics ---
NEXT_PUBLIC_ANALYTICS_ID=""

# --- Super Admin Setup (first-time only) ---
SUPER_ADMIN_EMAIL="admin@placementconnect.com"
SUPER_ADMIN_PASSWORD="change-this-on-first-login"
